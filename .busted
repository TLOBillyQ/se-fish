-- Busted 车道配置（#81，ADR 0002）。
-- fast 为日常车道（default 等价 fast）；full 追加 slow Lua（tests/tooling/slow、tests/native/slow）。
-- recursive 必须显式为 false：Busted 默认递归，fast 沿目录递归会捕获 tests/tooling/slow。
-- pattern 只匹配 *_test.lua；探针（tests/probes）、共享夹具（tests/support）、LuaUnit（tests/lib）
-- 与 Python 回归（tests/tooling/slow/*.py）不在任何 ROOT 内或没有 Lua 加载器，均不进入发现范围。
-- sort-files 保留旧入口 tests/run.lua 的文件名顺序；不开启 sort-tests，案例保持注册顺序。
local fast_roots = { "tests/gameplay", "tests/tooling", "tests/native" }
local full_roots = { "tests/gameplay", "tests/tooling", "tests/tooling/slow", "tests/native", "tests/native/slow" }

return {
  _all = {
    pattern = "_test",
    recursive = false,
    helper = "tests/native/helper.lua",
    ["sort-files"] = true,
    output = "plainTerminal",
  },
  default = { ROOT = fast_roots },
  fast = { ROOT = fast_roots },
  full = { ROOT = full_roots },
}
