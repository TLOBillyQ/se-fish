+def format_decisions(results, *, verbose=False) -> str:
+    """本轮执行和历史复用独立于快照中的 killed/survived 聚合。"""
+    counts = {action: 0 for action in ("executed", "reused", "uncovered", "excluded")}
+    lines = []
+    for result in results:
+        functions = {(form.namespace, form.id): dict.fromkeys(counts, 0) for form in result.forms}
+        details = []
+        for site in result.sites:
+            decision = result.decisions.get(site.mutation_id)
+            if decision is None:
+                continue
+            action, reason, previous = decision
+            counts[action] += 1
+            functions[(site.namespace, site.form_id)][action] += 1
+            if verbose:
+                outcome = result.statuses.get(site.mutation_id, "none")
+                details.append(f"{site.file}:{site.line} {site.namespace}/{site.name} "
+                               f"action={action} reason={reason} previous={previous} "
+                               f"result={outcome} id={site.mutation_id}")
+        for form in result.forms:
+            totals = functions[(form.namespace, form.id)]
+            lines.append(f"Mutation function: {form.namespace}/{form.name} " +
+                         " ".join(f"{key}={value}" for key, value in totals.items()))
+        lines.extend(details)
+    lines.append("Mutation run: " + " ".join(f"{key}={value}" for key, value in counts.items()))
+    return "\n".join(lines) + "\n"
+
+
